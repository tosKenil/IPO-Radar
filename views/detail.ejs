<%- include('partials/header', { title: ipo.name, activePage: 'detail' }) %>

<main class="main">
  <!-- Back Button & Quick Allotment Check Button -->
  <div class="container back-bar" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <a href="/" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
    <a href="/allotment-status?ipo=<%= ipo.symbol %>" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 8px;">
      <i class="fa-solid fa-square-check"></i> Check My Allotment Status
    </a>
  </div>

  <div class="container detail-layout">
    <!-- Left: Main Info -->
    <div class="detail-main">

      <!-- Company Header Card -->
      <div class="detail-hero-card">
        <div class="detail-hero-top">
          <div class="detail-logo"><%= ipo.symbol.charAt(0) %></div>
          <div class="detail-company-info">
            <div class="detail-meta-row">
              <span class="ipo-category <%= ipo.category === 'SME' ? 'sme' : 'main' %>"><%= ipo.category %></span>
              <% if (ipo.issueType) { %><span class="ipo-sector"><%= ipo.issueType %></span><% } %>
              <div class="status-badge status-<%= ipo.status %> ml-auto">
                <% if (ipo.status === 'open') { %><span class="pulse-dot"></span><% } %>
                <%= (ipo.status === 'allotment' || ipo.status === 'closed') ? 'Allotment Pending' : ipo.status.charAt(0).toUpperCase() + ipo.status.slice(1) %>
              </div>
            </div>
            <h1 class="detail-company-name"><%= ipo.name %></h1>
            <span class="detail-symbol">NSE: <%= ipo.symbol %></span>
          </div>
        </div>

        <!-- Return Banner for Listed IPOs -->
        <% if (ipo.currentReturnPct !== null) { %>
        <div class="return-banner <%= parseFloat(ipo.currentReturnPct) >= 0 ? 'positive' : 'negative' %>">
          <div class="rb-item">
            <span class="rb-label">Issue Price</span>
            <span class="rb-value">₹<%= ipo.issuePrice %></span>
          </div>
          <div class="rb-arrow">
            <i class="fa-solid fa-arrow-right"></i>
          </div>
          <div class="rb-item">
            <span class="rb-label">Listing Price</span>
            <span class="rb-value"><%= ipo.listingPrice ? '₹' + ipo.listingPrice : 'TBA' %></span>
          </div>
          <div class="rb-arrow"><i class="fa-solid fa-arrow-right"></i></div>
          <div class="rb-item">
            <span class="rb-label">Current Price</span>
            <span class="rb-value">₹<%= ipo.currentPrice %></span>
          </div>
          <div class="rb-returns">
            <% if (ipo.listingReturnPct !== null) { %>
            <div class="rb-return-item">
              <span class="rb-label">Listing Return</span>
              <span class="rb-big <%= parseFloat(ipo.listingReturnPct) >= 0 ? 'text-green' : 'text-red' %>">
                <%= parseFloat(ipo.listingReturnPct) >= 0 ? '+' : '' %><%= ipo.listingReturnPct %>%
              </span>
            </div>
            <% } %>
            <div class="rb-return-item">
              <span class="rb-label">Current Return</span>
              <span class="rb-big <%= parseFloat(ipo.currentReturnPct) >= 0 ? 'text-green' : 'text-red' %>">
                <%= parseFloat(ipo.currentReturnPct) >= 0 ? '+' : '' %><%= ipo.currentReturnPct %>%
              </span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Estimated Listing Gain & Price Banner for Open / Upcoming IPOs -->
        <% 
          const detailEst = typeof getEstimateListing === 'function' ? getEstimateListing(ipo) : null;
          const detailExp = typeof getExpectedReturn === 'function' ? getExpectedReturn(ipo) : null;
        %>
        <% if (ipo.currentReturnPct === null && (detailEst || detailExp)) { %>
        <div class="return-banner positive" style="background: rgba(16,185,129,0.06); border-top: 1px solid rgba(16,185,129,0.2);">
          <div class="rb-item">
            <span class="rb-label">Base / Cutoff Price</span>
            <span class="rb-value">₹<%= detailEst ? detailEst.cutoffPrice : (ipo.issuePrice || (ipo.priceband ? ipo.priceband.split('-').pop().trim() : 'TBA')) %></span>
          </div>
          <div class="rb-arrow"><i class="fa-solid fa-arrow-right"></i></div>
          <div class="rb-item">
            <span class="rb-label">Est. Listing Price</span>
            <span class="rb-value text-green"><%= detailEst ? detailEst.listingPriceFormatted : 'TBA' %></span>
          </div>
          <div class="rb-returns">
            <div class="rb-return-item">
              <span class="rb-label">Est. Listing Gain (%)</span>
              <span class="rb-big text-green"><%= detailEst ? detailEst.gainPctFormatted : (detailExp ? detailExp.formatted : 'TBA') %></span>
            </div>
          </div>
        </div>
        <% } %>
      </div>

      <!-- IPO Timeline -->
      <div class="glass-card">
        <h2 class="card-title"><i class="fa-solid fa-timeline"></i> IPO Timeline</h2>
        <div class="timeline">
          <div class="tl-item <%= ipo.openDate && new Date() >= new Date(ipo.openDate) ? 'done' : '' %>">
            <div class="tl-dot"></div>
            <span class="tl-date"><%= formatDate(ipo.openDate) %></span>
            <span class="tl-label">Bidding Opens</span>
          </div>
          <div class="tl-line <%= ipo.closeDate && new Date() >= new Date(ipo.closeDate) ? 'done' : '' %>"></div>
          <div class="tl-item <%= ipo.closeDate && new Date() >= new Date(ipo.closeDate) ? 'done' : '' %>">
            <div class="tl-dot"></div>
            <span class="tl-date"><%= formatDate(ipo.closeDate) %></span>
            <span class="tl-label">Bidding Closes</span>
          </div>
          <div class="tl-line <%= ipo.allotmentDate && new Date() >= new Date(ipo.allotmentDate) ? 'done' : '' %>"></div>
          <div class="tl-item <%= ipo.allotmentDate && new Date() >= new Date(ipo.allotmentDate) ? 'done' : '' %>">
            <div class="tl-dot"></div>
            <span class="tl-date"><%= formatDate(ipo.allotmentDate) %></span>
            <span class="tl-label">Basis of Allotment</span>
          </div>
          <div class="tl-line <%= ipo.listingDate && new Date() >= new Date(ipo.listingDate) ? 'done' : '' %>"></div>
          <div class="tl-item <%= ipo.listingDate && new Date() >= new Date(ipo.listingDate) ? 'done' : '' %>">
            <div class="tl-dot"></div>
            <span class="tl-date"><%= formatDate(ipo.listingDate) %></span>
            <span class="tl-label">Stock Listing</span>
          </div>
        </div>
      </div>

      <!-- Subscription Details -->
      <% if (ipo.subscriptionTimes || ipo.qibSubscription || ipo.niiSubscription || ipo.retailSubscription) { %>
      <div class="glass-card">
        <h2 class="card-title"><i class="fa-solid fa-users"></i> Subscription Details</h2>
        <div class="sub-progress-list">
          <% if (ipo.qibSubscription) { %>
          <div class="progress-item">
            <div class="progress-header">
              <span class="progress-name">QIB (Institutional)</span>
              <span class="progress-pct"><%= ipo.qibSubscription %>x</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: <%= Math.min(100, (ipo.qibSubscription / 20) * 100) %>%; background: var(--accent);"></div>
            </div>
          </div>
          <% } %>
          <% if (ipo.niiSubscription) { %>
          <div class="progress-item">
            <div class="progress-header">
              <span class="progress-name">NII / HNI</span>
              <span class="progress-pct"><%= ipo.niiSubscription %>x</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: <%= Math.min(100, (ipo.niiSubscription / 20) * 100) %>%; background: #a78bfa;"></div>
            </div>
          </div>
          <% } %>
          <% if (ipo.retailSubscription) { %>
          <div class="progress-item">
            <div class="progress-header">
              <span class="progress-name">Retail Individual</span>
              <span class="progress-pct"><%= ipo.retailSubscription %>x</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: <%= Math.min(100, (ipo.retailSubscription / 20) * 100) %>%; background: var(--green);"></div>
            </div>
          </div>
          <% } %>
        </div>
        <% if (ipo.subscriptionTimes) { %>
        <div class="total-sub-badge">
          <span>Total Subscription:</span>
          <strong><%= ipo.subscriptionTimes %>x</strong>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- Issue Information -->
      <div class="glass-card">
        <h2 class="card-title"><i class="fa-solid fa-circle-info"></i> Issue Information</h2>
        <table class="details-table">
          <% if (ipo.issueType) { %><tr><td>Issue Type</td><td><%= ipo.issueType %></td></tr><% } %>
          <% if (ipo.faceValue) { %><tr><td>Face Value</td><td><%= ipo.faceValue %></td></tr><% } %>
          <% if (ipo.registrar) { %><tr><td>Registrar</td><td><%= ipo.registrar %></td></tr><% } %>
        </table>
        <% if (!ipo.issueType && !ipo.faceValue && !ipo.registrar) { %>
        <p class="about-text">Detailed issue information isn't available from the data source for this IPO yet.</p>
        <% } %>
      </div>

      <!-- Official Documents -->
      <% if (ipo.documents && ipo.documents.length) { %>
      <div class="glass-card">
        <h2 class="card-title"><i class="fa-solid fa-file-lines"></i> Official Documents (NSE)</h2>
        <ul class="manager-list">
          <% ipo.documents.forEach(doc => { %>
          <li><i class="fa-solid fa-chevron-right"></i> <a href="<%= doc.url %>" target="_blank" rel="noopener"><%= doc.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </div>

    <!-- Right: Sidebar -->
    <aside class="detail-sidebar">

      <!-- IPO Details -->
      <div class="glass-card">
        <h2 class="card-title"><i class="fa-solid fa-info-circle"></i> IPO Details</h2>
        <table class="details-table">
          <tr><td>Price Band</td><td><%= ipo.priceband ? '₹' + ipo.priceband : 'TBA' %></td></tr>
          <tr><td>Issue Price</td><td><%= ipo.issuePrice ? '₹' + ipo.issuePrice : 'TBA' %></td></tr>
          <tr><td>Lot Size</td><td><%= ipo.lotSize ? ipo.lotSize + ' shares' : 'TBA' %></td></tr>
          <tr>
            <td>1 Lot Total Amount</td>
            <td>
              <% 
                let lotAmt = typeof getOneLotAmount === 'function' ? getOneLotAmount(ipo) : null;
              %>
              <%= lotAmt ? '₹' + lotAmt.toLocaleString('en-IN') : 'TBA' %>
            </td>
          </tr>
          <tr>
            <td>Est. Listing Price</td>
            <td>
              <strong style="color: var(--green); font-size: 1.05rem;">
                <%= detailEst ? detailEst.listingPriceFormatted : 'TBA' %>
              </strong>
            </td>
          </tr>
          <tr>
            <td>Est. Listing Gain (%)</td>
            <td>
              <% if (detailEst) { %>
                <strong class="<%= detailEst.isPositive ? 'text-green' : 'text-red' %>" style="font-size: 1.05rem;">
                  <%= detailEst.gainPctFormatted %>
                </strong>
              <% } else if (detailExp) { %>
                <strong class="<%= detailExp.isPositive ? 'text-green' : 'text-red' %>" style="font-size: 1.05rem;">
                  <%= detailExp.formatted %>
                </strong>
              <% } else { %>
                TBA
              <% } %>
            </td>
          </tr>
          <tr>
            <td>100 એ કેટલાને લાગશે</td>
            <td>
              <% 
                let chance = typeof getAllotmentChance === 'function' ? getAllotmentChance(ipo) : null;
              %>
              <strong style="color: var(--amber);"><%= chance || 'TBA' %></strong>
            </td>
          </tr>
          <tr>
            <td>હાથમાં રકમ (1 Lot નફો)</td>
            <td>
              <% 
                let inHand = typeof getInHandAmount === 'function' ? getInHandAmount(ipo) : null;
              %>
              <% if (inHand) { %>
                <strong class="<%= inHand.isPositive ? 'text-green' : 'text-red' %>" style="font-size: 1.05rem;">
                  <%= inHand.profitFormatted %>
                </strong>
                <span style="font-size: 0.8rem; color: var(--text-muted); display: block;">(કુલ વેચાણ: ₹<%= inHand.totalValue.toLocaleString('en-IN') %>)</span>
              <% } else { %>
                TBA
              <% } %>
            </td>
          </tr>
          <tr><td>Issue Size</td><td><%= ipo.issueSize || '—' %></td></tr>
          <% if (ipo.registrar) { %><tr><td>Registrar</td><td><%= ipo.registrar %></td></tr><% } %>
        </table>

        <!-- Check Allotment Button Inside Sidebar -->
        <div style="margin-top: 18px;">
          <a href="/allotment-status?ipo=<%= ipo.symbol %>" class="btn-primary" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;">
            <i class="fa-solid fa-square-check"></i> Check My Allotment Status
          </a>
        </div>
      </div>

      <!-- Return Calculator -->
      <% if (ipo.currentPrice && ipo.issuePrice) { %>
      <div class="glass-card calculator-card">
        <h2 class="card-title"><i class="fa-solid fa-calculator"></i> Return Calculator</h2>
        <div class="calc-form">
          <label>Number of Lots</label>
          <div class="calc-input-row">
            <button class="calc-btn" onclick="adjustLots(-1)">−</button>
            <input type="number" id="lotsInput" value="1" min="1" max="100" onchange="calculateReturn()" />
            <button class="calc-btn" onclick="adjustLots(1)">+</button>
          </div>
          <div class="calc-summary" id="calcSummary">
            <div class="calc-row">
              <span>Investment</span>
              <span id="calcInvestment">₹0</span>
            </div>
            <div class="calc-row">
              <span>Current Value</span>
              <span id="calcCurrentVal">₹0</span>
            </div>
            <div class="calc-row total">
              <span>Estimated P&amp;L</span>
              <span id="calcProfit" class="text-green">+₹0</span>
            </div>
            <div class="calc-row">
              <span>Return %</span>
              <span class="<%= parseFloat(ipo.currentReturnPct) >= 0 ? 'text-green' : 'text-red' %>"><%= parseFloat(ipo.currentReturnPct) >= 0 ? '+' : '' %><%= ipo.currentReturnPct %>%</span>
            </div>
          </div>
        </div>
      </div>
      <script>
        const issuePrice = <%= ipo.issuePrice %>;
        const currentPrice = <%= ipo.currentPrice %>;
        const lotSize = <%= ipo.lotSize %>;
        function formatINR(n) { return '₹' + n.toLocaleString('en-IN'); }
        function adjustLots(d) {
          const inp = document.getElementById('lotsInput');
          inp.value = Math.max(1, parseInt(inp.value) + d);
          calculateReturn();
        }
        function calculateReturn() {
          const lots = parseInt(document.getElementById('lotsInput').value) || 1;
          const inv = issuePrice * lotSize * lots;
          const cur = currentPrice * lotSize * lots;
          const profit = cur - inv;
          document.getElementById('calcInvestment').textContent = formatINR(inv);
          document.getElementById('calcCurrentVal').textContent = formatINR(cur);
          const profitEl = document.getElementById('calcProfit');
          profitEl.textContent = (profit >= 0 ? '+' : '') + formatINR(profit);
          profitEl.className = profit >= 0 ? 'text-green' : 'text-red';
        }
      </script>
      <% } %>

      <!-- Lead Managers -->
      <% if (ipo.leadManagers && ipo.leadManagers.length) { %>
      <div class="glass-card">
        <h2 class="card-title"><i class="fa-solid fa-handshake"></i> Lead Managers</h2>
        <ul class="manager-list">
          <% ipo.leadManagers.forEach(lm => { %>
          <li><i class="fa-solid fa-chevron-right"></i> <%= lm %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </aside>
  </div>
</main>

<%- include('partials/footer') %>
