<%- include('partials/header', { title: 'Upcoming IPOs', activePage: 'upcoming', searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '' }) %>

<% if (typeof dataStale !== 'undefined' && dataStale) { %>
<div class="stale-banner">
  <i class="fa-solid fa-triangle-exclamation"></i>
  Live data source is temporarily unreachable — showing the last successful fetch.
</div>
<% } %>

<main class="main">
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="hero-bg-orbs">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
    </div>
    <div class="page-hero-content">
      <div class="hero-tag"><i class="fa-solid fa-rocket"></i> Coming Soon</div>
      <h1 class="hero-title">Upcoming <span class="gradient-text">IPOs</span></h1>
      <p class="hero-subtitle">Explore IPOs opening soon — plan ahead with price bands, issue sizes &amp; expected dates.</p>
    </div>
  </section>

  <!-- Filter & Search Section -->
  <section class="filter-section" style="padding-bottom: 16px;">
    <div class="container">
      <div class="filter-toolbar" style="justify-content: flex-end;">
        <div class="live-search-wrapper" style="width: 100%; max-width: 420px;">
          <i class="fa-solid fa-magnifying-glass live-search-icon"></i>
          <input 
            type="text" 
            id="upcomingSearchInput" 
            class="live-search-input" 
            placeholder="Search upcoming IPOs..." 
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" id="upcomingSearchClear" class="live-search-clear" title="Clear Search" style="display: <%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'inline-flex' : 'none' %>;">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>

      <!-- Search Status Bar -->
      <div id="upcomingStatusBar" class="search-status-bar" style="display: <%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'flex' : 'none' %>;">
        <span class="search-status-text">
          <i class="fa-solid fa-filter"></i>
          Showing <strong id="upcomingSearchCount"><%= ipos.length %></strong> Upcoming IPO<%= ipos.length === 1 ? '' : 's' %> <span id="upcomingSearchLabel"><%= searchQuery ? `matching "${searchQuery}"` : '' %></span>
        </span>
        <button type="button" id="btnResetUpcomingSearch" class="btn-reset-search">Clear Search</button>
      </div>
    </div>
  </section>

  <section class="cards-section">
    <div class="container">
      <!-- Dynamic empty message for client live search -->
      <div id="noResultsUpcoming" class="empty-state" style="display: none;">
        <i class="fa-solid fa-magnifying-glass"></i>
        <h3>No Upcoming IPOs found</h3>
        <p>No upcoming IPO matches your search query. Try another keyword or reset.</p>
        <button type="button" class="btn-primary" id="btnResetUpcomingEmpty" style="margin-top: 14px;">Reset Search</button>
      </div>

      <% if (ipos.length === 0) { %>
        <div class="empty-state">
          <i class="fa-solid fa-rocket"></i>
          <p>No upcoming IPOs found<%= searchQuery ? ` matching "${searchQuery}"` : '' %>.</p>
          <% if (searchQuery) { %>
            <a href="/upcoming" class="btn-primary" style="margin-top: 14px;">Clear Search</a>
          <% } %>
        </div>
      <% } else { %>
      <div class="upcoming-grid" id="upcomingGrid">
        <% ipos.forEach(function(ipo) { %>
        <div class="upcoming-card"
             data-name="<%= (ipo.name || '').toLowerCase() %>"
             data-symbol="<%= (ipo.symbol || '').toLowerCase() %>"
             data-category="<%= (ipo.category || '').toLowerCase() %>"
        >
          <div class="uc-header">
            <div class="ipo-logo"><%= ipo.symbol.charAt(0) %></div>
            <div class="uc-title-area">
              <div class="detail-meta-row">
                <span class="ipo-category <%= ipo.category === 'SME' ? 'sme' : 'main' %>"><%= ipo.category %></span>
                <span class="ipo-sector">NSE: <%= ipo.symbol %></span>
              </div>
              <h2 class="uc-name"><%= ipo.name %></h2>
            </div>
          </div>

          <div class="uc-body">
            <div class="uc-info-grid">
              <div class="uc-info-item">
                <span class="uc-info-label">Price Band</span>
                <span class="uc-info-value"><%= ipo.priceband ? '₹' + ipo.priceband : 'TBA' %></span>
              </div>
              <% const upEst = typeof getEstimateListing === 'function' ? getEstimateListing(ipo) : null; %>
              <% if (upEst) { %>
              <div class="uc-info-item">
                <span class="uc-info-label">Est. Listing Price</span>
                <span class="uc-info-value" style="color: var(--green); font-weight: 700;"><%= upEst.listingPriceFormatted %></span>
              </div>
              <div class="uc-info-item">
                <span class="uc-info-label">Est. Listing Gain</span>
                <span class="uc-info-value" style="color: var(--green); font-weight: 700;"><%= upEst.gainPctFormatted %></span>
              </div>
              <% } %>
              <div class="uc-info-item">
                <span class="uc-info-label">Issue Size</span>
                <span class="uc-info-value"><%= ipo.issueSize %></span>
              </div>
              <div class="uc-info-item">
                <span class="uc-info-label">Lot Size</span>
                <span class="uc-info-value"><%= ipo.lotSize ? ipo.lotSize + ' shares' : 'TBA' %></span>
              </div>
              <div class="uc-info-item">
                <span class="uc-info-label">1 Lot Total</span>
                <span class="uc-info-value" style="color: var(--accent); font-weight: 600;">
                  <% const lotAmt = typeof getOneLotAmount === 'function' ? getOneLotAmount(ipo) : null; %>
                  <%= lotAmt ? '₹' + lotAmt.toLocaleString('en-IN') : 'TBA' %>
                </span>
              </div>
              <% const upChance = typeof getAllotmentChance === 'function' ? getAllotmentChance(ipo) : null; %>
              <% if (upChance) { %>
              <div class="uc-info-item">
                <span class="uc-info-label">100 એ લાગશે</span>
                <span class="uc-info-value" style="color: var(--amber); font-weight: 600;"><%= upChance %></span>
              </div>
              <% } %>
            </div>

            <div class="uc-dates">
              <div class="uc-date-item open">
                <i class="fa-regular fa-calendar-plus"></i>
                <div>
                  <span class="date-label">Opens</span>
                  <span class="date-value"><%= formatDate(ipo.openDate) %></span>
                </div>
              </div>
              <div class="uc-date-sep"><i class="fa-solid fa-arrow-right"></i></div>
              <div class="uc-date-item close">
                <i class="fa-regular fa-calendar-minus"></i>
                <div>
                  <span class="date-label">Closes</span>
                  <span class="date-value"><%= formatDate(ipo.closeDate) %></span>
                </div>
              </div>
              <div class="uc-date-sep"><i class="fa-solid fa-arrow-right"></i></div>
              <div class="uc-date-item allotment">
                <i class="fa-regular fa-calendar-check"></i>
                <div>
                  <span class="date-label">Allotment</span>
                  <span class="date-value"><%= formatDate(ipo.allotmentDate) %></span>
                </div>
              </div>
              <div class="uc-date-sep"><i class="fa-solid fa-arrow-right"></i></div>
              <div class="uc-date-item listing">
                <i class="fa-solid fa-building-columns"></i>
                <div>
                  <span class="date-label">Listing</span>
                  <span class="date-value"><%= formatDate(ipo.listingDate) %></span>
                </div>
              </div>
            </div>

            <p class="uc-about">
              <% if (ipo.leadManagers && ipo.leadManagers.length) { %>
                <strong>Lead Manager<%= ipo.leadManagers.length > 1 ? 's' : '' %>:</strong> <%= ipo.leadManagers.join(', ') %>
              <% } %>
              <% if (ipo.registrar) { %>
                <br /><strong>Registrar:</strong> <%= ipo.registrar %>
              <% } %>
            </p>
          </div>

          <div class="uc-footer">
            <a href="/ipo/<%= ipo.id %>" class="btn-primary">View Full Details <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </section>
</main>

<script>
  // Client-side Instant Search for Upcoming IPOs
  (function() {
    const input = document.getElementById('upcomingSearchInput');
    const clearBtn = document.getElementById('upcomingSearchClear');
    const statusBar = document.getElementById('upcomingStatusBar');
    const countSpan = document.getElementById('upcomingSearchCount');
    const labelSpan = document.getElementById('upcomingSearchLabel');
    const btnReset = document.getElementById('btnResetUpcomingSearch');
    const btnResetEmpty = document.getElementById('btnResetUpcomingEmpty');
    const noResults = document.getElementById('noResultsUpcoming');
    const grid = document.getElementById('upcomingGrid');

    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.upcoming-card'));

    function applyFilter(query) {
      const q = (query || '').toLowerCase().trim();

      if (clearBtn) {
        clearBtn.style.display = q ? 'inline-flex' : 'none';
      }

      let visibleCount = 0;

      cards.forEach(card => {
        if (!q) {
          card.style.display = '';
          visibleCount++;
          return;
        }

        const name = card.getAttribute('data-name') || '';
        const symbol = card.getAttribute('data-symbol') || '';
        const cat = card.getAttribute('data-category') || '';
        const text = card.textContent.toLowerCase();

        if (name.includes(q) || symbol.includes(q) || cat.includes(q) || text.includes(q)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (statusBar) {
        if (q) {
          statusBar.style.display = 'flex';
          if (countSpan) countSpan.textContent = visibleCount;
          if (labelSpan) labelSpan.textContent = `matching "${q}"`;
        } else {
          statusBar.style.display = 'none';
        }
      }

      if (noResults) {
        if (visibleCount === 0 && q) {
          noResults.style.display = 'block';
          grid.style.display = 'none';
        } else {
          noResults.style.display = 'none';
          grid.style.display = 'grid';
        }
      }
    }

    if (input) {
      input.addEventListener('input', function(e) {
        applyFilter(e.target.value);
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        if (input) input.value = '';
        applyFilter('');
        if (input) input.focus();
      });
    }

    if (btnReset) {
      btnReset.addEventListener('click', function() {
        if (input) input.value = '';
        applyFilter('');
      });
    }

    if (btnResetEmpty) {
      btnResetEmpty.addEventListener('click', function() {
        if (input) input.value = '';
        applyFilter('');
      });
    }
  })();
</script>

<%- include('partials/footer') %>