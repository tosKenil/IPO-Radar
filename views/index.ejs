<%- include('partials/header', { title: 'Dashboard', activePage: 'home', searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '' }) %>

<% if (typeof dataStale !== 'undefined' && dataStale) { %>
<div class="stale-banner">
  <i class="fa-solid fa-triangle-exclamation"></i>
  Live data source is temporarily unreachable — showing the last successful fetch.
</div>
<% } %>

<main class="main">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg-orbs">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div class="hero-content">
      <div class="hero-tag"><i class="fa-solid fa-fire"></i> Live IPO Tracker</div>
      <h1 class="hero-title">IPO <span class="gradient-text">Dashboard</span></h1>
      <p class="hero-subtitle">Track all active, upcoming, allotment &amp; recently listed IPOs — dates, returns &amp; subscription status in real-time.</p>
    </div>
  </section>

  <!-- Filter & Search Section -->
  <section class="filter-section">
    <div class="container">
      <div class="filter-toolbar">
        <div class="filter-tabs" id="filterTabs">
          <a href="/?filter=all<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" id="tab-all" class="filter-tab <%= filter === 'all' ? 'active' : '' %>">
            <i class="fa-solid fa-border-all"></i> All IPOs
            <span class="tab-count"><%= allIpos.length %></span>
          </a>
          <a href="/?filter=open<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" id="tab-open" class="filter-tab <%= filter === 'open' ? 'active' : '' %>">
            <i class="fa-solid fa-circle-play"></i> Open
            <span class="tab-count"><%= allIpos.filter(i => (i.status || '').toLowerCase() === 'open').length %></span>
          </a>
          <a href="/?filter=allotment<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" id="tab-allotment" class="filter-tab <%= filter === 'allotment' ? 'active' : '' %>">
            <i class="fa-solid fa-envelope-open-text"></i> Allotment
            <span class="tab-count"><%= allIpos.filter(i => (i.status || '').toLowerCase() === 'allotment' || (i.status || '').toLowerCase() === 'closed').length %></span>
          </a>
          <a href="/?filter=upcoming<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" id="tab-upcoming" class="filter-tab <%= filter === 'upcoming' ? 'active' : '' %>">
            <i class="fa-solid fa-clock"></i> Upcoming
            <span class="tab-count"><%= allIpos.filter(i => (i.status || '').toLowerCase() === 'upcoming').length %></span>
          </a>
          <a href="/?filter=listed<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" id="tab-listed" class="filter-tab <%= filter === 'listed' ? 'active' : '' %>">
            <i class="fa-solid fa-check-circle"></i> Listed
            <span class="tab-count"><%= allIpos.filter(i => (i.status || '').toLowerCase() === 'listed').length %></span>
          </a>
        </div>

        <!-- Live Instant Search Box -->
        <div class="live-search-wrapper">
          <i class="fa-solid fa-magnifying-glass live-search-icon"></i>
          <input 
            type="text" 
            id="liveSearchInput" 
            class="live-search-input" 
            placeholder="Search IPOs instantly..." 
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            autocomplete="off"
            spellcheck="false"
          />
          <button type="button" id="liveSearchClear" class="live-search-clear" title="Clear Search" style="display: <%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'inline-flex' : 'none' %>;">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>

      <!-- Live Search Status / Active Query Feedback -->
      <div id="searchStatusBar" class="search-status-bar" style="display: <%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'flex' : 'none' %>;">
        <span class="search-status-text">
          <i class="fa-solid fa-filter"></i>
          Showing <strong id="liveSearchCount"><%= ipos.length %></strong> IPO<%= ipos.length === 1 ? '' : 's' %> <span id="liveSearchLabel"><%= searchQuery ? `matching "${searchQuery}"` : '' %></span>
        </span>
        <button type="button" id="btnResetSearch" class="btn-reset-search">Clear Search</button>
      </div>
    </div>
  </section>

  <!-- IPO Cards Grid -->
  <section class="cards-section">
    <div class="container">
      <!-- Dynamic empty message for client live search -->
      <div id="noResultsLive" class="empty-state" style="display: none;">
        <i class="fa-solid fa-magnifying-glass"></i>
        <h3>No IPOs found</h3>
        <p>No IPO matches your search query. Try another keyword or reset the search.</p>
        <button type="button" class="btn-primary" id="btnResetEmpty" style="margin-top: 14px;">Reset Search</button>
      </div>

      <% if (ipos.length === 0) { %>
        <div class="empty-state" id="initialEmptyState">
          <i class="fa-solid fa-inbox"></i>
          <p>No IPOs found for this filter<%= searchQuery ? ` matching "${searchQuery}"` : '' %>.</p>
          <a href="/?filter=all" class="btn-primary" style="margin-top: 14px;">View All IPOs</a>
        </div>
      <% } else { %>
      <div class="ipo-grid" id="ipoGrid">
        <% ipos.forEach(function(ipo) { %>
        <a href="/ipo/<%= ipo.id || ipo.symbol %>" 
           class="ipo-card" 
           id="ipo-card-<%= ipo.id || ipo.symbol %>"
           data-name="<%= (ipo.name || '').toLowerCase() %>"
           data-symbol="<%= (ipo.symbol || '').toLowerCase() %>"
           data-category="<%= (ipo.category || '').toLowerCase() %>"
           data-status="<%= (ipo.status || '').toLowerCase() %>"
        >
          <!-- Status Badge -->
          <div class="card-header">
            <div class="ipo-logo"><%= (ipo.symbol || ipo.name || 'I').charAt(0) %></div>
            <div class="status-badge status-<%= ipo.status %>">
              <% if (ipo.status === 'open') { %><span class="pulse-dot"></span><% } %>
              <%= (ipo.status === 'allotment' || ipo.status === 'closed') ? 'Allotment' : ipo.status.charAt(0).toUpperCase() + ipo.status.slice(1) %>
            </div>
          </div>

          <!-- Name & Category -->
          <div class="card-body">
            <div class="ipo-meta">
              <span class="ipo-category <%= ipo.category === 'SME' ? 'sme' : 'main' %>"><%= ipo.category %></span>
              <span class="ipo-sector">NSE: <%= ipo.symbol %></span>
            </div>
            <h2 class="ipo-name"><%= ipo.name %></h2>

            <!-- Price Info -->
            <div class="price-row">
              <div class="price-item">
                <span class="price-label">Issue Price</span>
                <span class="price-value"><%= ipo.issuePrice ? '₹' + ipo.issuePrice : 'TBA' %></span>
              </div>
              <% if (ipo.status === 'listed') { %>
              <div class="price-item">
                <span class="price-label">Listing Price</span>
                <span class="price-value"><%= ipo.listingPrice ? '₹' + ipo.listingPrice : 'TBA' %></span>
              </div>
              <div class="price-item">
                <span class="price-label">Current Price</span>
                <span class="price-value"><%= ipo.currentPrice ? '₹' + ipo.currentPrice : 'TBA' %></span>
              </div>
              <% } else { %>
              <div class="price-item">
                <span class="price-label">Price Band</span>
                <span class="price-value"><%= ipo.priceband ? '₹' + ipo.priceband : 'TBA' %></span>
              </div>
              <div class="price-item">
                <span class="price-label">Est. Listing Price</span>
                <span class="price-value" style="color: var(--green); font-weight: 700;">
                  <% const cardEst = typeof getEstimateListing === 'function' ? getEstimateListing(ipo) : null; %>
                  <%= cardEst ? cardEst.listingPriceFormatted : 'TBA' %>
                </span>
              </div>
              <div class="price-item">
                <span class="price-label">1 Lot Total</span>
                <span class="price-value" style="color: var(--accent); font-weight: 600;"><% const lotAmt = typeof getOneLotAmount === 'function' ? getOneLotAmount(ipo) : null; %><%= lotAmt ? '₹' + lotAmt.toLocaleString('en-IN') : 'TBA' %></span>
              </div>
              <% } %>
            </div>

            <!-- Return Badge (Est. Listing Gain % or Actual Current Return) -->
            <% 
              const cardEst = typeof getEstimateListing === 'function' ? getEstimateListing(ipo) : null;
              const cardExp = typeof getExpectedReturn === 'function' ? getExpectedReturn(ipo) : null;
            %>
            <% if (cardEst) { %>
            <div class="return-strip <%= cardEst.isPositive ? 'positive' : 'negative' %>">
              <i class="fa-solid <%= cardEst.isPositive ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i>
              <span class="return-label"><%= cardEst.labelGain %> (%)</span>
              <span class="return-value"><%= cardEst.gainPctFormatted %></span>
            </div>
            <% } else if (cardExp) { %>
            <div class="return-strip <%= cardExp.isPositive ? 'positive' : 'negative' %>">
              <i class="fa-solid <%= cardExp.isPositive ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down' %>"></i>
              <span class="return-label"><%= cardExp.isEstimated ? 'Est. Listing Gain' : 'Current Return' %></span>
              <span class="return-value"><%= cardExp.formatted %></span>
            </div>
            <% } %>

            <!-- Dates (Actual SEBI T+3 Dates) -->
            <div class="dates-grid">
              <div class="date-item">
                <i class="fa-regular fa-calendar"></i>
                <div>
                  <span class="date-label">Open</span>
                  <span class="date-value"><%= formatDate(ipo.openDate) %></span>
                </div>
              </div>
              <div class="date-item">
                <i class="fa-regular fa-calendar-check"></i>
                <div>
                  <span class="date-label">Allotment</span>
                  <span class="date-value"><%= formatDate(ipo.allotmentDate) %></span>
                </div>
              </div>
              <div class="date-item">
                <i class="fa-solid fa-building-columns"></i>
                <div>
                  <span class="date-label">Listing</span>
                  <span class="date-value"><%= formatDate(ipo.listingDate) %></span>
                </div>
              </div>
            </div>

            <!-- Subscription & Allotment / In-Hand Row -->
            <% 
              const cardChance = typeof getAllotmentChance === 'function' ? getAllotmentChance(ipo) : null;
              const cardInHand = typeof getInHandAmount === 'function' ? getInHandAmount(ipo) : null;
            %>
            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 10px;">
              <% if (cardChance) { %>
              <div class="sub-row">
                <span class="sub-label"><i class="fa-solid fa-users"></i> 100 એ લાગશે</span>
                <span class="sub-value" style="font-size: 0.85rem;"><%= cardChance %></span>
              </div>
              <% } else if (ipo.subscriptionTimes) { %>
              <div class="sub-row">
                <span class="sub-label"><i class="fa-solid fa-signal"></i> Subscribed</span>
                <span class="sub-value"><%= ipo.subscriptionTimes %>x</span>
              </div>
              <% } %>

              <% if (cardEst && cardEst.isEstimated) { %>
              <div class="sub-row" style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.15);">
                <span class="sub-label"><i class="fa-solid fa-chart-line" style="color: var(--green);"></i> Est. Listing Price</span>
                <span class="text-green" style="font-weight: 800; font-size: 0.95rem;">
                  <%= cardEst.listingPriceFormatted %> <span style="font-size: 0.78rem; opacity: 0.85;">(<%= cardEst.gainPctFormatted %>)</span>
                </span>
              </div>
              <% } %>

              <% if (cardInHand) { %>
              <div class="sub-row" style="background: <%= cardInHand.isPositive ? 'rgba(16,185,129,0.08)' : 'rgba(239,68,68,0.08)' %>;">
                <span class="sub-label"><i class="fa-solid fa-hand-holding-dollar"></i> હાથમાં રકમ (1 Lot)</span>
                <span class="<%= cardInHand.isPositive ? 'text-green' : 'text-red' %>" style="font-weight: 800; font-size: 0.95rem;">
                  <%= cardInHand.profitFormatted %>
                  <% if (cardInHand.isEstimated) { %><span style="font-size: 0.72rem; opacity: 0.8; font-weight: 500;">(અંદાજિત)</span><% } %>
                </span>
              </div>
              <% } %>
            </div>
          </div>

          <div class="card-footer">
            <span class="view-details">View Details <i class="fa-solid fa-arrow-right"></i></span>
          </div>
        </a>
        <% }); %>
      </div>
      <% } %>
    </div>
  </section>
</main>

<script>
  // Client-side Instant Search & Live Filter
  (function() {
    const liveInput = document.getElementById('liveSearchInput');
    const liveClear = document.getElementById('liveSearchClear');
    const navInput = document.getElementById('navSearchInput');
    const statusBar = document.getElementById('searchStatusBar');
    const countSpan = document.getElementById('liveSearchCount');
    const labelSpan = document.getElementById('liveSearchLabel');
    const btnReset = document.getElementById('btnResetSearch');
    const btnResetEmpty = document.getElementById('btnResetEmpty');
    const noResults = document.getElementById('noResultsLive');
    const grid = document.getElementById('ipoGrid');

    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('.ipo-card'));

    function applyFilter(query) {
      const q = (query || '').toLowerCase().trim();

      // Sync inputs if different
      if (navInput && navInput.value !== query) {
        navInput.value = query;
      }
      if (liveInput && liveInput.value !== query) {
        liveInput.value = query;
      }

      if (liveClear) {
        liveClear.style.display = q ? 'inline-flex' : 'none';
      }

      let visibleCount = 0;

      cards.forEach(card => {
        if (!q) {
          card.style.display = '';
          visibleCount++;
          return;
        }

        const name = card.getAttribute('data-name') || '';
        const symbol = card.getAttribute('data-symbol') || '';
        const cat = card.getAttribute('data-category') || '';
        const status = card.getAttribute('data-status') || '';
        const text = card.textContent.toLowerCase();

        if (name.includes(q) || symbol.includes(q) || cat.includes(q) || status.includes(q) || text.includes(q)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update feedback bar
      if (statusBar) {
        if (q) {
          statusBar.style.display = 'flex';
          if (countSpan) countSpan.textContent = visibleCount;
          if (labelSpan) labelSpan.textContent = `matching "${q}"`;
        } else {
          statusBar.style.display = 'none';
        }
      }

      // Handle 0 results
      if (noResults) {
        if (visibleCount === 0 && q) {
          noResults.style.display = 'block';
          grid.style.display = 'none';
        } else {
          noResults.style.display = 'none';
          grid.style.display = 'grid';
        }
      }
    }

    if (liveInput) {
      liveInput.addEventListener('input', function(e) {
        applyFilter(e.target.value);
      });
    }

    if (liveClear) {
      liveClear.addEventListener('click', function() {
        if (liveInput) liveInput.value = '';
        applyFilter('');
        if (liveInput) liveInput.focus();
      });
    }

    if (btnReset) {
      btnReset.addEventListener('click', function() {
        if (liveInput) liveInput.value = '';
        applyFilter('');
      });
    }

    if (btnResetEmpty) {
      btnResetEmpty.addEventListener('click', function() {
        if (liveInput) liveInput.value = '';
        applyFilter('');
      });
    }
  })();
</script>

<%- include('partials/footer') %>
